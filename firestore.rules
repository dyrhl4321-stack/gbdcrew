// 2026-07-12 기준 실제 콘솔 규칙 사본.
// 와일드카드로 모든 컬렉션 읽기/쓰기 허용 → gbd_members 도 이미 포함됨(별도 게시 불필요).
// 비번 5252 는 클라이언트 게이트일 뿐이며, 이 규칙은 익명 접근을 그대로 연다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
